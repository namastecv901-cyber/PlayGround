# systemd: بديل pm2 — يعيد التشغيل تلقائياً حتى بعد إعادة تشغيل السيرفر نفسه
# التثبيت (كجذر):
#   cp server/bot-server.service /etc/systemd/system/tradebot.service
#   systemctl daemon-reload && systemctl enable --now tradebot
#   journalctl -u tradebot -f   (لمشاهدة السجل)
[Unit]
Description=TradeBot Binance 24/7
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/PlayGround
ExecStart=/usr/bin/node /root/PlayGround/bot-server.js
# ♾️ استمرار بدون توقف: إعادة تشغيل دائمة حتى بعد الكراش أو إعادة تشغيل السيرفر نفسه
Restart=always
RestartSec=5
StartLimitIntervalSec=0
TimeoutStopSec=15
# الحفظ الدائم: STATE_FILE للبوت + PRIVATE_FILE لنظامك الخاص (يبقى بعد خروجك ودخولك)
# ⚠️ غيّر OWNER_CODE ليكون نفس كلمة سر my-system.html
Environment=MODE=paper
Environment=PORT=8787
Environment=STATE_FILE=/root/PlayGround/bot-state.json
Environment=PRIVATE_FILE=/root/PlayGround/private-system.json
Environment=OWNER_CODE=1234
Environment=AUTOSAVE_SEC=20
Environment=STAKE_USD=20
Environment=TP_USD=0.7
Environment=MIN_TP_USD=0.3
Environment=MAX_TRADES=3
Environment=DAILY_MAX_LOSS=10
Environment=DAILY_GOAL_USD=10
Environment=EQUITY_START=100
Environment=POLL_SEC=60

[Install]
WantedBy=multi-user.target
